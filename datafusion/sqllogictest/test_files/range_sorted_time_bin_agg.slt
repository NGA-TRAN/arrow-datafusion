##########
# TEST 10: Nested aggregation. The inner step is TEST 9 (GROUP BY key,
# time_bin, col1). The outer step groups by (col1, time_bin). Range
# partitioning projects through date_trunc('hour') onto time_bin, so the
# outer grouping is also a superset of the range key and stays
# SinglePartitioned with no hash shuffle.
##########

query TT
EXPLAIN SELECT col1, time_bin, sum(value)
FROM (
     SELECT key, col1, date_trunc('hour', timestamp) AS time_bin, sum(value) as value
     FROM range_sorted_time_bin
     WHERE col4 = 'a'
     GROUP BY key, time_bin, col1
) as inner
GROUP BY col1, time_bin;
----
physical_plan
01)AggregateExec: mode=SinglePartitioned, gby=[col1@0 as col1, time_bin@1 as time_bin], aggr=[sum(inner.value)]
02)--ProjectionExec: expr=[col1@2 as col1, date_trunc(Utf8("hour"),range_sorted_time_bin.timestamp)@1 as time_bin, sum(range_sorted_time_bin.value)@3 as value]
03)----AggregateExec: mode=SinglePartitioned, gby=[key@0 as key, date_trunc(hour, timestamp@2) as date_trunc(Utf8("hour"),range_sorted_time_bin.timestamp), col1@1 as col1], aggr=[sum(range_sorted_time_bin.value)], ordering_mode=PartiallySorted([0, 1])
04)------FilterExec: col4@2 = a, projection=[key@0, col1@1, timestamp@3, value@4]
05)--------DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch_range_partitioning/range_sorted_time_bin/part-0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch_range_partitioning/range_sorted_time_bin/part-1.parquet]]}, projection=[key, col1, col4, timestamp, value], output_ordering=[key@0 ASC, timestamp@3 ASC], output_partitioning=Range([timestamp@3 ASC], [(1704070800000000000)], 2), file_type=parquet, predicate=col4@4 = a, pruning_predicate=col4_null_count@2 != row_count@3 AND col4_min@0 <= a AND a <= col4_max@1, required_guarantees=[col4 in (a)]

query TPI
SELECT col1, time_bin, sum(value)
FROM (
     SELECT key, col1, date_trunc('hour', timestamp) AS time_bin, sum(value) as value
     FROM range_sorted_time_bin
     WHERE col4 = 'a'
     GROUP BY key, time_bin, col1
) as inner
GROUP BY col1, time_bin
ORDER BY col1, time_bin;
----
x 2024-01-01T00:00:00 10
x 2024-01-01T01:00:00 65

##########
# TEST 11: Star-schema join after fact time-bin aggregation.
#
#   dim  (small): key, timestamp, col1, col2 — Range([timestamp]), same hour split
#   fact (large): key FK, timestamp, value  — Range([timestamp]), sorted (key, timestamp)
#
#   1. Filter dim on col1 = 'x' (no date_bin on dim)
#   2. Aggregate fact: GROUP BY (key, date_bin(60 minutes)) → sum(value) AS value
#   3. Partitioned HashJoin on key only
#   4. Aggregate join output: GROUP BY (col2, time_bin) → sum(value)
#
# Join-on-key is not satisfied by Range([timestamp]): the same key lives in
# both hour partitions (dim has k1 in hour 0 and hour 1). A partition-wise
# join would miss cross-hour key matches, so both sides are Hash([key])
# shuffled. Unused dim.timestamp is projected away, so the dim scan is
# UnknownPartitioning rather than Range.
#
# After the key shuffle, each fact key matches every dim row with that key:
#   y 00:00 = 102 * 2, y 01:00 = 30 * 2, z 00:00 = 7, z 01:00 = 35
# (hour-1 dim k2 has col1='b' and is filtered out, but hour-0 dim k2
# still matches hour-1 fact k2).
#
# Hash-join thresholds of 0 keep the join Partitioned (not CollectLeft) even
# though dim is small. Dim is listed first so it is the build side and fact
# is the probe side.
##########

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold = 0;

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold_rows = 0;

statement ok
set datafusion.optimizer.subset_repartition_threshold = 0;

query TT
EXPLAIN SELECT d.col2, f.time_bin, sum(f.value) AS value
FROM (
    SELECT key, col2
    FROM range_sorted_time_bin_dim
    WHERE col1 = 'x'
) AS d
JOIN (
    SELECT key, date_bin(INTERVAL '60 minutes', timestamp) AS time_bin, sum(value) AS value
    FROM range_sorted_time_bin_fact
    GROUP BY key, time_bin
) AS f
ON f.key = d.key
GROUP BY d.col2, f.time_bin;
----
physical_plan
01)ProjectionExec: expr=[col2@0 as col2, time_bin@1 as time_bin, sum(f.value)@2 as value]
02)--AggregateExec: mode=FinalPartitioned, gby=[col2@0 as col2, time_bin@1 as time_bin], aggr=[sum(f.value)]
03)----RepartitionExec: partitioning=Hash([col2@0, time_bin@1], 2), input_partitions=2
04)------AggregateExec: mode=Partial, gby=[col2@0 as col2, time_bin@1 as time_bin], aggr=[sum(f.value)]
05)--------HashJoinExec: mode=Partitioned, join_type=Inner, on=[(key@0, key@0)], projection=[col2@1, time_bin@3, value@4]
06)----------RepartitionExec: partitioning=Hash([key@0], 2), input_partitions=2
07)------------FilterExec: col1@1 = x, projection=[key@0, col2@2]
08)--------------DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch_range_partitioning/range_sorted_time_bin_dim/part-0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch_range_partitioning/range_sorted_time_bin_dim/part-1.parquet]]}, projection=[key, col1, col2], output_partitioning=UnknownPartitioning(2), file_type=parquet, predicate=col1@1 = x, pruning_predicate=col1_null_count@2 != row_count@3 AND col1_min@0 <= x AND x <= col1_max@1, required_guarantees=[col1 in (x)]
09)----------RepartitionExec: partitioning=Hash([key@0], 2), input_partitions=2
10)------------ProjectionExec: expr=[key@0 as key, date_bin(IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 0, nanoseconds: 3600000000000 }"),range_sorted_time_bin_fact.timestamp)@1 as time_bin, sum(range_sorted_time_bin_fact.value)@2 as value]
11)--------------AggregateExec: mode=SinglePartitioned, gby=[key@0 as key, date_bin(IntervalMonthDayNano { months: 0, days: 0, nanoseconds: 3600000000000 }, timestamp@1) as date_bin(IntervalMonthDayNano("IntervalMonthDayNano { months: 0, days: 0, nanoseconds: 3600000000000 }"),range_sorted_time_bin_fact.timestamp)], aggr=[sum(range_sorted_time_bin_fact.value)], ordering_mode=Sorted
12)----------------DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch_range_partitioning/range_sorted_time_bin_fact/part-0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch_range_partitioning/range_sorted_time_bin_fact/part-1.parquet]]}, projection=[key, timestamp, value], output_ordering=[key@0 ASC, timestamp@1 ASC], output_partitioning=Range([timestamp@1 ASC], [(1704070800000000000)], 2), file_type=parquet

query TPI
SELECT d.col2, f.time_bin, sum(f.value) AS value
FROM (
    SELECT key, col2
    FROM range_sorted_time_bin_dim
    WHERE col1 = 'x'
) AS d
JOIN (
    SELECT key, date_bin(INTERVAL '60 minutes', timestamp) AS time_bin, sum(value) AS value
    FROM range_sorted_time_bin_fact
    GROUP BY key, time_bin
) AS f
ON f.key = d.key
GROUP BY d.col2, f.time_bin
ORDER BY d.col2, f.time_bin;
